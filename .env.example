# ==========================================
# Newtonite Operations Platform Environment
# ==========================================

# Environment & Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database Configuration
# Local PostgreSQL default on port 5434
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/newtonite?schema=public"
DATABASE_TEST_URL="postgresql://postgres:postgres@localhost:5434/newtonite_test?schema=public"

# Authentication & Security
# WARNING: Replace with a cryptographically secure random string in production!
JWT_SECRET="dev-insecure-secret-key-min-32-chars-long-newtonite-2026"
JWT_EXPIRES_IN="8h"
DEMO_PASSWORD_SALT_ROUNDS=10

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Rate Limiting & Resilience
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
IDEMPOTENCY_TTL_SECONDS=86400

# Client Web App (Vite)
VITE_API_URL="http://localhost:4000/api/v1"
